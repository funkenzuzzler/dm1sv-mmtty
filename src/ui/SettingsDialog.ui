<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>720</width><height>520</height></rect></property>
  <property name="windowTitle"><string>MMTTY Settings</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex"><number>0</number></property>
     <widget class="QWidget" name="stationPage">
      <attribute name="title"><string>Station</string></attribute>
      <layout class="QFormLayout" name="stationForm">
       <item row="0" column="0">
        <widget class="QLabel" name="label_call">
         <property name="text"><string>My call sign</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="call">
         <property name="maxLength"><number>16</number></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="soundPage">
      <attribute name="title"><string>Sound &amp;&amp; PTT</string></attribute>
      <layout class="QFormLayout" name="soundForm">
       <item row="0" column="0">
        <widget class="QLabel" name="label_inputDevice">
         <property name="text"><string>Sound input</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="inputDevice">
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_outputDevice">
         <property name="text"><string>Sound output</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QComboBox" name="outputDevice">
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_channel">
         <property name="text"><string>Input channel</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QComboBox" name="channel">
         <item>
          <property name="text"><string notr="true">Left / mono</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Right</string></property>
         </item>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_rate">
         <property name="text"><string>Sampling rate (needs restart)</string></property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QComboBox" name="rate">
         <item>
          <property name="text"><string notr="true">11025 Hz</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">12000 Hz</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">8000 Hz</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">6000 Hz</string></property>
         </item>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="label_txOffset">
         <property name="text"><string>TX clock correction (Hz)</string></property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QDoubleSpinBox" name="txOffset">
         <property name="decimals"><number>1</number></property>
         <property name="minimum"><double>-1000.0</double></property>
         <property name="maximum"><double>1000.0</double></property>
         <property name="singleStep"><double>0.1</double></property>
         <property name="value"><double>0.0</double></property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="label_pttPort">
         <property name="text"><string>PTT / FSK serial port</string></property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QComboBox" name="pttPort">
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="label_pttLines">
         <property name="text"><string>PTT line</string></property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QComboBox" name="pttLines">
         <item>
          <property name="text"><string notr="true">None</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">RTS</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">DTR</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">RTS + DTR</string></property>
         </item>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="pttInvert">
         <property name="text"><string>Invert PTT polarity</string></property>
        </widget>
       </item>
       <item row="8" column="0">
        <widget class="QLabel" name="label_fskLine">
         <property name="text"><string>FSK line</string></property>
        </widget>
       </item>
       <item row="8" column="1">
        <widget class="QComboBox" name="fskLine">
         <property name="toolTip"><string>Software FSK: the selected control line is toggled with exact bit timing instead of sending audio. Wire it to the radio's FSK input. It cannot also be a PTT line.</string></property>
         <item>
          <property name="text"><string notr="true">Off (AFSK through the sound card)</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">DTR</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">RTS</string></property>
         </item>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QCheckBox" name="fskInvert">
         <property name="text"><string>Invert FSK polarity (mark = line off)</string></property>
        </widget>
       </item>
       <item row="10" column="1">
        <widget class="QPushButton" name="rescanButton">
         <property name="text"><string>Rescan ports</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="txPage">
      <attribute name="title"><string>Transmit &amp;&amp; AFC</string></attribute>
      <layout class="QFormLayout" name="txForm">
       <item row="0" column="0">
        <widget class="QLabel" name="label_echo">
         <property name="text"><string>Echo</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="echo">
         <item>
          <property name="text"><string notr="true">Direct (no echo)</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Sound loopback echo</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">External echo (receiver stays open)</string></property>
         </item>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_dataBits">
         <property name="text"><string>Data bits</string></property>
