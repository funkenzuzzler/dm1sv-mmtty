         <item>
          <property name="text"><string notr="true">5</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">6</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">7</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">8</string></property>
         </item>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_stopBits">
         <property name="text"><string>Stop bits</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QComboBox" name="stopBits">
         <item>
          <property name="text"><string notr="true">1</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">1.5</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">2</string></property>
         </item>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_parity">
         <property name="text"><string>Parity</string></property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QComboBox" name="parity">
         <item>
          <property name="text"><string notr="true">None</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Even</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Odd</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Mark</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Space</string></property>
         </item>
        </widget>
       </item>
       <item row="4" column="0" colspan="2">
        <widget class="QCheckBox" name="txNet">
         <property name="text"><string>TX frequency follows RX (NET)</string></property>
        </widget>
       </item>
       <item row="5" column="0" colspan="2">
        <widget class="QCheckBox" name="txFix">
         <property name="text"><string>Use the fixed shift below when transmitting</string></property>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="label_defMark">
         <property name="text"><string>Default TX mark (Hz)</string></property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QDoubleSpinBox" name="defMark">
         <property name="decimals"><number>0</number></property>
         <property name="minimum"><double>300</double></property>
         <property name="maximum"><double>2700</double></property>
         <property name="singleStep"><double>1</double></property>
         <property name="value"><double>2125</double></property>
        </widget>
       </item>
       <item row="7" column="0">
        <widget class="QLabel" name="label_defShift">
         <property name="text"><string>Default TX shift (Hz)</string></property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QDoubleSpinBox" name="defShift">
         <property name="decimals"><number>0</number></property>
         <property name="minimum"><double>10</double></property>
         <property name="maximum"><double>2000</double></property>
         <property name="singleStep"><double>1</double></property>
         <property name="value"><double>170</double></property>
        </widget>
       </item>
       <item row="8" column="0" colspan="2">
        <widget class="QCheckBox" name="txUos">
         <property name="text"><string>Unshift on space (transmit)</string></property>
        </widget>
       </item>
       <item row="9" column="0" colspan="2">
        <widget class="QCheckBox" name="rxUos">
         <property name="text"><string>Unshift on space (receive)</string></property>
        </widget>
       </item>
       <item row="10" column="0">
        <widget class="QLabel" name="label_afcMode">
         <property name="text"><string>AFC mode</string></property>
        </widget>
       </item>
       <item row="10" column="1">
        <widget class="QComboBox" name="afcMode">
         <item>
          <property name="text"><string notr="true">Free shift</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Fixed shift</string></property>
         </item>
         <item>
          <property name="text"><string notr="true">Ham shifts (170/200/220/240)</string></property>
         </item>
        </widget>
       </item>
       <item row="11" column="0">
        <widget class="QLabel" name="label_afcSquelch">
         <property name="text"><string>AFC squelch</string></property>
        </widget>
       </item>
       <item row="11" column="1">
        <widget class="QSpinBox" name="afcSquelch">
         <property name="minimum"><number>1</number></property>
         <property name="maximum"><number>255</number></property>
        </widget>
       </item>
       <item row="12" column="0">
        <widget class="QLabel" name="label_afcTime">
         <property name="text"><string>AFC time constant</string></property>
        </widget>
       </item>
       <item row="12" column="1">
        <widget class="QDoubleSpinBox" name="afcTime">
         <property name="decimals"><number>1</number></property>
         <property name="minimum"><double>1.0</double></property>
         <property name="maximum"><double>64.0</double></property>
         <property name="singleStep"><double>0.5</double></property>
         <property name="value"><double>8.0</double></property>
        </widget>
       </item>
       <item row="13" column="0">
        <widget class="QLabel" name="label_afcSweep">
         <property name="text"><string>AFC sweep range</string></property>
        </widget>
       </item>
       <item row="13" column="1">
        <widget class="QDoubleSpinBox" name="afcSweep">
         <property name="decimals"><number>1</number></property>
         <property name="minimum"><double>0.5</double></property>
         <property name="maximum"><double>3.0</double></property>
         <property name="singleStep"><double>0.1</double></property>
         <property name="value"><double>1.0</double></property>
        </widget>
       </item>
